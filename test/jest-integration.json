{
  "rootDir": "..",
  "testEnvironment": "node",
  "testMatch": ["<rootDir>/test/integration/**/*.spec.ts", "<rootDir>/test/load/**/*.spec.ts"],
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json" }]
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  },
  "clearMocks": true,
  "testTimeout": 60000,
  "maxWorkers": 1
}
