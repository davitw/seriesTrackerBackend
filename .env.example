# Conexão principal (aplicação). Postgres do Supabase ou local.
#
# Não acrescente `?schema=public` à URL. O Prisma usa `public` por padrão, e o parâmetro faz
# o `psql` recusar a mesma string — o que quebraria scripts/setup-db.sql e as verificações.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/series_tracker

# Conexão usada apenas pelos testes de integração e de carga.
# Se ausente, a suíte de integração FALHA com mensagem explícita (nunca é pulada em silêncio).
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/series_tracker_test

# Conexões usadas APENAS por `prisma migrate deploy` e por scripts/setup-db.sql.
# Precisam de uma role privilegiada, porque as migrações criam funções SECURITY DEFINER.
# A aplicação nunca usa estas variáveis: ela roda com a role sem privilégios, e é isso
# que faz a Row Level Security valer de verdade (Princípio I).
MIGRATE_DATABASE_URL=postgresql://postgres@localhost:5432/series_tracker
TEST_MIGRATE_DATABASE_URL=postgresql://postgres@localhost:5432/series_tracker_test

# Segredo de assinatura do access token (JWT HS256). Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=IbKY3I+l3Ergnt/orlHSA1jsrX/0+OJuT9DjsWB+yjNmjnLrc4ww2qiGapGYkbhf

# Credencial do catálogo externo (TMDB).
# Use o "API Read Access Token" (v4) — o valor longo que começa com "ey".
# A API Key v3 (32 caracteres hexadecimais) NÃO serve: o cliente envia a credencial
# no cabeçalho Authorization, não como ?api_key=. Ver research.md R-005.
TMDB_API_KEY=troque-este-valor

# Porta HTTP
PORT=3000

# Limitação de taxa das rotas públicas de autenticação (FR-021)
AUTH_RATE_LIMIT_TTL=60
AUTH_RATE_LIMIT_MAX=10
